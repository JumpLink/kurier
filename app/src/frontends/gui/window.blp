using Gtk 4.0;
using Adw 1;

/**
 * The window's shell — the whole widget tree that is the *app* rather than the conversation.
 *
 * **What is left here after `@lotse/widget`.** The two panes, their header bars, the primary menu
 * and the privacy banner: everything that names kurier rather than a chat. The conversation itself —
 * the five states, the transcript and the composer under them — is `packages/widget/src/chat.blp`,
 * slotted into `chatHost`, and `docs/adr/0001-lotse-as-an-embeddable-widget.md` draws that line.
 * This window is now one host among possible others, which is why the split is worth the two files.
 *
 * The session list is still built in TypeScript and slotted into `sidebarHost`, for the reason the
 * widget's own hosts exist: what it contains is a running agent's, not a tree. The `Adw.Bin` hosts
 * are deliberately the thinnest container in the toolkit — one child, no layout of its own — so a
 * host is invisible in the result rather than a level of nesting that has to be argued about.
 * `Adw.NavigationPage`s WITHOUT a `title:` here is the same "show-title: false" the header bar asks
 * for; the titles themselves are applied from `constants.ts` in the constructor, so there is one
 * place that spells the app's name.
 */
template $KurierMainWindow: Adw.ApplicationWindow {
  content: Adw.NavigationSplitView split {
    min-sidebar-width: 260;
    max-sidebar-width: 340;
    // Not collapsed on a wide monitor: a sidebar that starts hidden hides the list for no reason,
    // which is the "control that points at nothing" in its other direction. The breakpoint in
    // `window.ts` collapses it when the window genuinely has no room — and **only** the breakpoint
    // may do that. Measured: a breakpoint applies on a condition *change*, so one manual
    // `collapsed = false` while the window is already narrow means it never collapses again, at
    // any width, in that process. A client moves between the panes with `show_content`;
    // libadwaita owns `collapsed`.
    collapsed: false;

    sidebar: Adw.NavigationPage sidebarPage {
      // **`Adw.ToolbarView` with the header bar as its `[top]` bar — never a bare
      // `Adw.HeaderBar` in a plain `Gtk.Box`.** That is the documented shape since libadwaita
      // 1.4 and it is what `@gjsify/adwaita-app`'s own `createNavShell` builds. It also decides how
      // the pane's edge looks: a bare header bar does not merge with the pane beside it, and
      // `Adw.NavigationSplitView` then draws its separator straight through the header row — a
      // vertical rule across the top of the window that no GNOME app has. The pixels are in
      // `scripts/probes/headerbar-ab.mjs` and in the `window.ts` header.
      child: Adw.ToolbarView {
        vexpand: true;
        [top]
        Adw.HeaderBar {
          // No `show-title: false` and no `show-*TitleButtons: false` here. The former is what
          // keeps the page's own title out of this bar; the latter hid the close button on the
          // collapsed window, where this bar is the only one on screen, and left alone libadwaita
          // puts the window buttons on whichever bar sits at the window's edge, in both shapes.
          //
          // `Adw.WindowTitle`, not a `Gtk.Label` with `title-1`: that name class is for a *window*
          // title, and at that size a sidebar label reads as shouting. The empty subtitle is the
          // measured shape, not an oversight — see `window.ts`.
          title-widget: Adw.WindowTitle sidebarTitle {
            subtitle: "";
          };

          // **New chat lives in the sidebar's bar, where the list it adds to is.** `win.new-chat` is the
          // one entry point: this button, `<Ctrl>n` and `KU_APP_NEW_CHAT` all activate the action that
          // `MainWindow` installs, so a screenshot of the hook is a screenshot of the button's own path.
          [start]
          Gtk.Button {
            icon-name: "list-add-symbolic";
            action-name: "win.new-chat";
            tooltip-text: _("New chat");

            accessibility {
              label: _("New chat");
            }
          }
        }
        content: Adw.Bin sidebarHost {};
      };
    };

    content: Adw.NavigationPage contentPage {
      child: Adw.ToolbarView {
        vexpand: true;
        [top]
        // `show-title: false`, and **that is not cosmetic.** An `Adw.HeaderBar` inside an
        // `Adw.NavigationPage` shows that page's title, so naming this page up front printed the
        // app's name twice across the top of the window — the sidebar said it and the content pane
        // said it again, which is this file's own "no control that points at nothing" rule
        // committed by a title instead of by a button. libadwaita says the same in as many words:
        // "AdwNavigationPage … is missing a title. To hide a header bar title, consider using
        // AdwHeaderBar:show-title instead." `MainWindow.#open` turns the title on, because from that
        // point it names a session rather than the app.
        //
        // **The back button is libadwaita's, not ours.** An `Adw.HeaderBar` in the content page of
        // a collapsed `Adw.NavigationSplitView` grows one by itself as soon as `show_content` is
        // true. This file once claimed the opposite and shipped its own button, from a measurement
        // that rested on an API that does not exist: there is no `get_start_widget()` in libadwaita
        // 1.9.3 (0 hits in `Adw-1.gir`), and `show_content` was `false` — its default — in every
        // state measured, so nothing could have been seen to go back to. The screenshot after the
        // session list first set it to `true` then showed two back buttons side by side. What the
        // collapsed window was missing was never a button; it was `MainWindow.#open`.
        Adw.HeaderBar contentHeader {
          show-title: false;

          // The primary menu holds the app-level actions; `app.preferences` is installed by
          // `MainWindow.#installPreferences`, which also binds `<Ctrl>comma`.
          [end]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            menu-model: primary_menu;
            primary: true;
            tooltip-text: "Main menu";
          }
        }
        // The privacy notice for the bundled agent: a second top bar, so it sits right under the header.
        // Fixed English text and the button label come from `core/empty-state.ts`; hidden until
        // `MainWindow` reveals it. `use-markup: false` because the text is data, not markup.
        [top]
        Adw.Banner noticeBanner {
          revealed: false;
          use-markup: false;
        }
        // **The chat, and this `Adw.Bin` is the whole of the window's side of the split.** No bottom
        // bar here: the composer is the widget's own, because `Adw.ToolbarView` has exactly one and
        // the composer has to survive every switch between the conversation's states — see
        // `chat.blp`. What that costs this file is the `bottom-bar-style: flat` that used to be on
        // this view; it moved with the bar it was about.
        content: Adw.Bin chatHost {};
      };
    };
  };
}

/**
 * The two idle pages, declared OUTSIDE the template — and that placement is the point.
 *
 * `KurierChat`'s `closed` and `no-agent` states are `Adw.Bin` slots, because the copy on them can
 * only be written by something that knows what surrounds the chat: "pick a session from the list"
 * names this window's sidebar, and the remedy for a missing agent names kurier's own installer and
 * its Preferences dialog. So these two pages are the app's, they live here as markup like every
 * other static tree, and `MainWindow` parents them into the widget's slots.
 *
 * **A top-level object is still an internal child.** It is bound by id exactly like one inside the
 * template and survives a `System.gc()` unparented — measured on GTK 4 / libadwaita before this file
 * was written, because an unreferenced builder object would otherwise have been a page that
 * disappeared the first time the collector ran.
 */
Adw.StatusPage closedPage {
  icon-name: "mail-send-receive-symbolic";
  title: _("No session open");
  // Not "on the left": on a narrow window the list is a page of its own. The wording is about
  // kurier rather than about the agent — no agent is running yet, and copy that implies
  // otherwise is a small lie in the first screen anybody sees. "Start a new chat" names the
  // button in the sidebar's header bar, which exists now.
  description: _("Pick a session from the list, or start a new chat. The agent starts when you send your first message.");
  // `vexpand` so it centres in the pane: an empty area with content jammed under the
  // header reads as a layout bug rather than as a deliberate empty state.
  vexpand: true;

  styles [
    "compact",
    "kurier-calm",
  ]

  // The one action of the page. `win.new-chat` is the same action as the sidebar's `+` and
  // `<Ctrl>n`, so the button adds no path of its own.
  child: Gtk.Button {
    label: _("New chat");
    action-name: "win.new-chat";
    halign: center;

    styles [
      "suggested-action",
      "pill",
    ]
  };
}

// No agent could be found. Texts come from `emptyStateView` (core); the commands are
// selectable labels so they can be copied, never markup.
Adw.StatusPage noAgentPage {
  icon-name: "dialog-warning-symbolic";
  vexpand: true;

  styles [
    "compact",
    "kurier-calm",
  ]

  child: Gtk.Box {
    orientation: vertical;
    spacing: 12;
    halign: center;

    Gtk.Label noAgentBody {
      wrap: true;
      use-markup: false;
      justify: center;
      max-width-chars: 56;
    }

    // The install command as a card: a command is something to copy, so the copy button
    // sits on it rather than somewhere the eye has to travel to. The label is selectable
    // too, for a partial copy. Filled from `emptyStateView`, never written here.
    Gtk.Box noAgentCommands {
      orientation: horizontal;
      spacing: 6;
      halign: center;

      styles [
        "card",
      ]

      Gtk.Label noAgentCommand {
        use-markup: false;
        selectable: true;
        wrap: true;
        xalign: 0;
        hexpand: true;
        margin-start: 12;
        margin-top: 8;
        margin-bottom: 8;

        styles [
          "monospace",
        ]
      }

      Gtk.Button noAgentCopy {
        icon-name: "edit-copy-symbolic";
        tooltip-text: _("Copy");
        valign: center;
        margin-end: 6;

        styles [
          "flat",
        ]

        accessibility {
          label: _("Copy");
        }
      }
    }

    Gtk.LinkButton noAgentDocs {
      halign: center;
    }

    Gtk.Button noAgentPreferences {
      label: _("Preferences");
      action-name: "app.preferences";
      halign: center;
      visible: false;

      styles [
        "suggested-action",
        "pill",
      ]
    }
  };
}

menu primary_menu {
  section {
    item {
      label: "Log in to a provider…";
      action: "win.login";
    }
  }

  section {
    item {
      label: "Preferences";
      action: "app.preferences";
    }
  }
}
