{
  "id": "eu.jumplink.Kurier",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.node24",
    "org.freedesktop.Sdk.Extension.typescript"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/node24/bin:/usr/lib/sdk/typescript/bin:/app/bin"
  },
  "command": "kurier-app",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--talk-name=org.freedesktop.Flatpak",
    "--filesystem=host"
  ],
  "modules": [
    {
      "name": "kurier",
      "buildsystem": "simple",
      "build-commands": [
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs install --immutable",
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace kurier-cli build",
        "XDG_CACHE_HOME=\"$PWD/flatpak-gjsify-cache\" gjs -m build-aux/gjsify.gjs.mjs workspace kurier-cli build:app",
        "install -d /app/bin",
        "printf '#!/usr/bin/gjs -m\\n' > /app/bin/kurier-app",
        "cat app/dist/kurier-app.gjs.mjs >> /app/bin/kurier-app",
        "chmod 0755 /app/bin/kurier-app",
        "printf '#!/usr/bin/gjs -m\\n' > /app/bin/kurier",
        "cat app/dist/kurier.gjs.mjs >> /app/bin/kurier",
        "chmod 0755 /app/bin/kurier",
        "install -Dm644 data/eu.jumplink.Kurier.desktop /app/share/applications/eu.jumplink.Kurier.desktop",
        "install -Dm644 data/eu.jumplink.Kurier.metainfo.xml /app/share/metainfo/eu.jumplink.Kurier.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/eu.jumplink.Kurier.svg /app/share/icons/hicolor/scalable/apps/eu.jumplink.Kurier.svg",
        "install -Dm644 data/icons/hicolor/symbolic/apps/eu.jumplink.Kurier-symbolic.svg /app/share/icons/hicolor/symbolic/apps/eu.jumplink.Kurier-symbolic.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/JumpLink/kurier.git",
          "tag": "v0.1.0",
          "x-checker-data": {
            "type": "git",
            "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$",
            "version-scheme": "semantic"
          }
        },
        {
          "type": "file",
          "path": "build-aux/gjsify.gjs.mjs"
        },
        "gjsify-sources.json"
      ]
    }
  ]
}
