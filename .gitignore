# Dependencies
node_modules/

# Build output
dist/

# `gjsify ship` output — multi-hundred-MB local verification artifacts, rebuilt on demand.
app/ship/

# gjsify
.gjsify/

# gjsify's dev link — a LOCAL override pointing the install at the gjsify checkout in this
# workspace. Never committed: `gjsify install --immutable` refuses to run while it is present, and
# CI installs only what gjsify-lock.json pins. Create it with `gjsify link <path>` when working on
# gjsify itself; `gjsify unlink` removes it.
.gjsify-link.json

# npm is not the package manager here — `gjsify install` is (see AGENTS.md).
package-lock.json

# ─── Local state — NEVER commit ───────────────────────────────────────────
# Defence in depth only. The real guarantee is that no session data is ever WRITTEN here:
# lotse's store lives at $XDG_DATA_HOME/lotse/sessions.json, outside the repo, by
# construction (see app/src/core/store.ts). This repository is PUBLIC.
lotse-data/
*.sessions.json
sessions.json

# Editor / OS
.DS_Store
*.log
