{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 110,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/*.json",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/node_modules",
    "**/dist",
    "**/lib",
    "**/coverage",
    "**/*.gjs.mjs",
    "**/*.node.mjs",
    // GENERATED by `@gjsify/vite-plugin-blueprint` beside each `.blp` and committed per gjsify
    // ADR 0088 §4, so `gjsify blueprint types` has a real artifact to hold. The emitter writes its
    // final bytes with a hardcoded 4-space indent and reads `printWidth` but NOT `tabWidth` (gjsify
    // `packages/infra/blueprint/src/typed-exports.mjs`), so under this file's `tabWidth: 2` oxfmt
    // rewrites every one of them — and a hand-reindented sidecar would then fail the drift check.
    // Excluded from the formatter, not reindented.
    "**/*.d.blp.ts"
  ]
}
