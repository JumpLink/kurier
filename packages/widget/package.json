{
  "name": "@lotse/widget",
  "version": "0.1.1",
  "license": "LGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "description": "The chat surface, as a widget a host embeds: LotseChat renders one conversation — transcript, composer, model and mode controls, the tool and thought cards, the permission dialog — over @lotse/core's AgentSession. GTK/Adw, no app shell: the host passes the agent choice, the paths, the cwd, its mcpServers and its own permission gate.",
  "exports": {
    ".": "./src/index.ts",
    "./tool-line": "./src/tool-line.ts",
    "./permission-dialog": "./src/permission-dialog.ts"
  },
  "scripts": {
    "check": "gjsify tsc --noEmit --project tsconfig.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@lotse/acp": "*",
    "@lotse/core": "*",
    "@lotse/session": "*"
  },
  "peerDependencies": {
    "@girs/adw-1": "^5.4.0",
    "@girs/gdk-4.0": "^5.4.0",
    "@girs/glib-2.0": "^5.4.0",
    "@girs/gobject-2.0": "^5.4.0",
    "@girs/gtk-4.0": "^5.4.0",
    "@girs/pango-1.0": "^5.4.0"
  },
  "devDependencies": {
    "@girs/adw-1": "5.4.0",
    "@girs/gdk-4.0": "5.4.0",
    "@girs/glib-2.0": "5.4.0",
